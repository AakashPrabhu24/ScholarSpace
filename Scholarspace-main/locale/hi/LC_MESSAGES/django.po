msgid "Phone (E.164 format: +919876543210)"
msgstr "फ़ोन (E.164 प्रारूप: +919876543210)"

msgid "Include country code: +919876543210 (India) or +14155552671 (US)"
msgstr "देश कोड शामिल करें: +919876543210 (भारत) या +14155552671 (अमेरिका)"

